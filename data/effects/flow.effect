// AC Super FX - Fondo animado (humo / gradiente) generado por shader.
uniform float4x4 ViewProj;
uniform float time;
uniform float4 color1; // acento
uniform float4 color2; // tinte
uniform float4 color3; // base / fondo
uniform float scale;
uniform float aspect;
uniform float opacity;
uniform float transparent; // 1.0 = sin fondo, solo el efecto

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData v_out;
	v_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	v_out.uv  = v_in.uv;
	return v_out;
}

float hash21(float2 p)
{
	return frac(sin(dot(p, float2(127.1, 311.7))) * 43758.5453);
}

float vnoise(float2 p)
{
	float2 i = floor(p);
	float2 f = frac(p);
	float2 u = f * f * (3.0 - 2.0 * f);

	float a = hash21(i);
	float b = hash21(i + float2(1.0, 0.0));
	float c = hash21(i + float2(0.0, 1.0));
	float d = hash21(i + float2(1.0, 1.0));

	return lerp(lerp(a, b, u.x), lerp(c, d, u.x), u.y);
}

float fbm(float2 p)
{
	float v   = 0.0;
	float amp = 0.5;
	for (int i = 0; i < 5; i++) {
		v   += amp * vnoise(p);
		p    = p * 2.02 + float2(17.3, 9.1);
		amp *= 0.5;
	}
	return v;
}

float4 PSSmoke(VertData v_in) : TARGET
{
	float2 p = float2(v_in.uv.x * aspect, v_in.uv.y) * scale;
	float t  = time;

	float2 q = float2(fbm(p + float2(0.0, t * 0.10)),
	                  fbm(p + float2(5.2, 1.3) - float2(t * 0.08, 0.0)));
	float2 r = float2(fbm(p + 3.0 * q + float2(1.7, 9.2) + float2(t * 0.15, 0.0)),
	                  fbm(p + 3.0 * q + float2(8.3, 2.8) - float2(0.0, t * 0.12)));
	float f  = fbm(p + 3.0 * r);

	float dens = clamp((f - 0.38) * 2.8, 0.0, 1.0);
	float mixt = clamp(length(r) * 0.9 - 0.2, 0.0, 1.0);

	float3 col = lerp(color3.rgb, color1.rgb, dens);
	col = lerp(col, color2.rgb, mixt * dens * 0.75);

	float a = opacity * lerp(1.0, dens, transparent);
	return float4(col * a, a);
}

float4 PSGradient(VertData v_in) : TARGET
{
	float2 p = float2(v_in.uv.x * aspect, v_in.uv.y) * scale;
	float t  = time;

	float a = 0.5 + 0.5 * sin(t * 0.30 + p.x * 1.6 + sin(p.y * 1.3 + t * 0.20) * 1.4);
	float b = 0.5 + 0.5 * sin(t * 0.23 + p.y * 1.9 + sin(p.x * 1.1 - t * 0.17) * 1.6 + 1.7);

	float3 col = lerp(color3.rgb, color1.rgb, a);
	col = lerp(col, color2.rgb, b * 0.65);

	float al = opacity * lerp(1.0, max(a, b), transparent);
	return float4(col * al, al);
}

technique Smoke
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSSmoke(v_in);
	}
}

technique Gradient
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSGradient(v_in);
	}
}
